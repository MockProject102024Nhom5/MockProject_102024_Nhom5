# Adding a new contract
def add_contract(company_name, contact_name, start_date, end_date, status, special_terms, provider_id):
    new_contract = Contract(
        company_name=company_name,
        contact_name=contact_name,
        start_date=start_date,
        end_date=end_date,
        status=status,
        special_terms=special_terms,
        provider_id=provider_id
    )
    session.add(new_contract)
    session.commit()

# Viewing all contracts
def view_contracts():
    return session.query(Contract).all()

# Viewing contract details
def view_contract_details(contract_id):
    return session.query(Contract).filter(Contract.contract_id == contract_id).first()

# Adding a new provider
def add_provider(provider_name, contact_person, contact_email, contact_phone):
    new_provider = Provider(
        provider_name=provider_name,
        contact_person=contact_person,
        contact_email=contact_email,
        contact_phone=contact_phone
    )
    session.add(new_provider)
    session.commit()

# Searching contracts by company name
def search_contracts(company_name):
    return session.query(Contract).filter(Contract.company_name.ilike(f"%{company_name}%")).all()
